<div class="event-bus-demo not-prose my-6 rounded border border-gray-300 p-4">
  <div class="flex flex-wrap items-center gap-4">
    <button
      type="button"
      class="place-order rounded bg-gray-800 px-3 py-1 text-white"
    >
      Place order
    </button>
    <label class="flex items-center gap-2">
      <input type="checkbox" class="loyalty-toggle" />
      Subscribe Loyalty Points service
    </label>
  </div>
  <pre
    class="demo-log mt-4 h-48 overflow-y-auto rounded bg-gray-100 p-3 text-sm"
    aria-live="polite">
  </pre>
</div>

<script>
  type OrderCreated = Readonly<{ type: "OrderCreated"; orderId: number }>;
  type Handler = (event: OrderCreated) => void;

  // A tiny in-memory bus. The publisher only knows about the bus,
  // never about who is listening.
  class EventBus {
    private handlers: Handler[] = [];
    subscribe(handler: Handler) {
      this.handlers.push(handler);
      return () => {
        this.handlers = this.handlers.filter((h) => h !== handler);
      };
    }
    publish(event: OrderCreated) {
      this.handlers.forEach((handler) => handler(event));
    }
  }

  function init() {
    document
      .querySelectorAll<HTMLElement>(".event-bus-demo:not([data-ready])")
      .forEach((root) => {
        root.dataset.ready = "true";
        const log = root.querySelector<HTMLElement>(".demo-log")!;
        log.textContent = ""; // prettier leaves whitespace inside the <pre>
        const write = (line: string) => {
          log.textContent += line + "\n";
          log.scrollTop = log.scrollHeight;
        };

        const bus = new EventBus();
        let nextId = 1;

        bus.subscribe((e) =>
          write(`  Kitchen: baking pizza for order ${e.orderId}`),
        );
        bus.subscribe((e) =>
          write(`  Delivery: scheduling driver for order ${e.orderId}`),
        );

        let unsubscribeLoyalty: (() => void) | null = null;
        root
          .querySelector(".loyalty-toggle")!
          .addEventListener("change", (ev) => {
            if ((ev.target as HTMLInputElement).checked) {
              unsubscribeLoyalty = bus.subscribe((e) =>
                write(`  Loyalty: +10 points for order ${e.orderId}`),
              );
              write("-- Loyalty service subscribed (publisher unchanged)");
            } else {
              unsubscribeLoyalty?.();
              write("-- Loyalty service unsubscribed");
            }
          });

        root.querySelector(".place-order")!.addEventListener("click", () => {
          const event: OrderCreated = Object.freeze({
            type: "OrderCreated",
            orderId: nextId++,
          });
          write(`Order Processing published ${event.type} #${event.orderId}`);
          bus.publish(event);
        });
      });
  }

  document.addEventListener("astro:page-load", init);
</script>
